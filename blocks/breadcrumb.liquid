{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-breadcrumb-{{ ai_gen_id }} {
    --ai-breadcrumb-bg: {{ block.settings.background_color }};
    --ai-breadcrumb-link: {{ block.settings.link_color }};
    --ai-breadcrumb-link-hover: {{ block.settings.link_hover_color }};
    --ai-breadcrumb-link-hover-bg: {{ block.settings.link_hover_background }};
    --ai-breadcrumb-current: {{ block.settings.current_color }};
    --ai-breadcrumb-current-bg: {{ block.settings.current_background }};
    --ai-breadcrumb-separator: {{ block.settings.separator_color }};
    --ai-breadcrumb-focus: {{ block.settings.focus_color }};
    --ai-breadcrumb-radius: {{ block.settings.border_radius }}px;
    --ai-breadcrumb-gap: {{ block.settings.item_spacing }}px;
    --ai-breadcrumb-size: {{ block.settings.font_size }}px;
    --ai-breadcrumb-weight: {{ block.settings.font_weight }};

    padding-block: {{ block.settings.padding_top }}px {{ block.settings.padding_bottom }}px;
    background-color: var(--ai-breadcrumb-bg, var(--plt-color-base-100));
    font-size: var(--ai-breadcrumb-size);
    font-weight: var(--ai-breadcrumb-weight);
    max-width: 100%;
  }

  .ai-breadcrumb-{{ ai_gen_id }} > ol {
    flex-wrap: wrap;
    gap: var(--ai-breadcrumb-gap);
    white-space: normal;
    list-style: none;
    margin: 0;
    padding-inline-start: 0;
  }

  .ai-breadcrumb-{{ ai_gen_id }} > ol > li + li::before {
    color: var(--ai-breadcrumb-separator, var(--plt-color-meta));
    border-color: currentColor;
    opacity: 0.6;
    margin-inline: calc(var(--ai-breadcrumb-gap) * 0.5);
  }

  .ai-breadcrumb-{{ ai_gen_id }}[data-separator='slash'] > ol > li + li::before {
    content: '/';
    rotate: none;
    border: 0;
    width: auto;
    height: auto;
    background: none;
    font-size: 0.8em;
    display: inline-flex;
    align-items: center;
  }

  .ai-breadcrumb-{{ ai_gen_id }}[data-separator='arrow'] > ol > li + li::before {
    content: '>';
    rotate: none;
    border: 0;
    width: auto;
    height: auto;
    background: none;
    font-size: 0.8em;
    display: inline-flex;
    align-items: center;
  }

  .ai-breadcrumb-{{ ai_gen_id }} .ai-breadcrumb__link {
    color: var(--ai-breadcrumb-link, var(--plt-color-primary));
    text-decoration: none;
    padding: 8px 12px;
    border-radius: var(--ai-breadcrumb-radius);
    transition:
      color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-breadcrumb-{{ ai_gen_id }} .ai-breadcrumb__link:hover {
    color: var(--ai-breadcrumb-link-hover, var(--plt-color-primary));
    background-color: var(--ai-breadcrumb-link-hover-bg, var(--plt-color-base-200));
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 2px 4px color-mix(in oklab, var(--plt-color-base-content) 12%, transparent);
  }

  .ai-breadcrumb-{{ ai_gen_id }} .ai-breadcrumb__link:focus-visible {
    outline: 2px solid var(--ai-breadcrumb-focus, var(--plt-color-primary));
    outline-offset: 2px;
  }

  .ai-breadcrumb-{{ ai_gen_id }} .ai-breadcrumb__current {
    color: var(--ai-breadcrumb-current, var(--plt-color-base-content));
    background-color: var(--ai-breadcrumb-current-bg, var(--plt-color-base-300));
    padding: 8px 12px;
    border-radius: var(--ai-breadcrumb-radius);
    font-weight: 500;
    cursor: default;
  }

  .ai-breadcrumb-{{ ai_gen_id }} .ai-breadcrumb__home-icon {
    width: 1em;
    height: 1em;
    margin-inline-end: 4px;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-breadcrumb-{{ ai_gen_id }} {
      font-size: calc(var(--ai-breadcrumb-size) * 0.9);
    }

    .ai-breadcrumb-{{ ai_gen_id }} > ol {
      gap: calc(var(--ai-breadcrumb-gap) * 0.8);
    }

    .ai-breadcrumb-{{ ai_gen_id }} .ai-breadcrumb__link,
    .ai-breadcrumb-{{ ai_gen_id }} .ai-breadcrumb__current {
      padding: 6px 8px;
    }
  }
{% endstyle %}

<nav
  class="d-breadcrumbs ai-breadcrumb-{{ ai_gen_id }}"
  aria-label="Breadcrumb"
  data-separator="{{ block.settings.separator_style }}"
  {{ block.shopify_attributes }}
>
  <ol>
    <li>
      <a href="{{ routes.root_url }}" class="ai-breadcrumb__link">
        {% if block.settings.show_home_icon %}
          <svg class="ai-breadcrumb__home-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
          </svg>
        {% endif %}
        {{ block.settings.home_text }}
      </a>
    </li>

    {% unless template == 'index' %}
      {% case template.name %}
        {% when 'product' %}
          {% if collections[product.collections.first.handle] %}
            <li>
              <a href="{{ collections[product.collections.first.handle].url }}" class="ai-breadcrumb__link">
                {{ collections[product.collections.first.handle].title }}
              </a>
            </li>
          {% endif %}
          <li>
            <span class="ai-breadcrumb__current" aria-current="page">{{ product.title }}</span>
          </li>

        {% when 'collection' %}
          <li>
            <span class="ai-breadcrumb__current" aria-current="page">{{ collection.title }}</span>
          </li>

        {% when 'blog' %}
          <li>
            <span class="ai-breadcrumb__current" aria-current="page">{{ blog.title }}</span>
          </li>

        {% when 'article' %}
          <li>
            <a href="{{ blog.url }}" class="ai-breadcrumb__link">{{ blog.title }}</a>
          </li>
          <li>
            <span class="ai-breadcrumb__current" aria-current="page">{{ article.title }}</span>
          </li>

        {% when 'page' %}
          <li>
            <span class="ai-breadcrumb__current" aria-current="page">{{ page.title }}</span>
          </li>

        {% when 'cart' %}
          <li>
            <span class="ai-breadcrumb__current" aria-current="page">Cart</span>
          </li>

        {% when 'search' %}
          <li>
            <span class="ai-breadcrumb__current" aria-current="page">
              {% if search.terms %}
                Search results for "{{ search.terms }}"
              {% else %}
                Search
              {% endif %}
            </span>
          </li>

        {% when '404' %}
          <li>
            <span class="ai-breadcrumb__current" aria-current="page">Page not found</span>
          </li>

        {% else %}
          <li>
            <span class="ai-breadcrumb__current" aria-current="page">{{ page_title }}</span>
          </li>
      {% endcase %}
    {% endunless %}
  </ol>
</nav>

{%- liquid
  assign position = 1
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": {{ position }},
        "item": {
          "@id": "{{ request.origin | append: routes.root_url }}",
          "name": "{{ block.settings.home_text | default: 'Home' | escape }}"
        }
      }
      {%- liquid
        assign position = position | plus: 1
      -%}
      {%- case template.name -%}
        {%- when 'product' -%}
          {%- if product.collections.first -%}
            ,{
              "@type": "ListItem",
              "position": {{ position }},
              "item": {
                "@id": "{{ request.origin | append: product.collections.first.url }}",
                "name": "{{ product.collections.first.title | default: 'Collection' | escape }}"
              }
            }
            {%- liquid
              assign position = position | plus: 1
            -%}
          {%- endif -%}
          ,{
            "@type": "ListItem",
            "position": {{ position }},
            "item": {
              "@id": "{{ request.origin | append: product.url }}",
              "name": "{{ product.title | default: 'Product' | escape }}"
            }
          }
        {%- when 'collection' -%}
          ,{
            "@type": "ListItem",
            "position": {{ position }},
            "item": {
              "@id": "{{ request.origin | append: collection.url }}",
              "name": "{{ collection.title | default: 'Collection' | escape }}"
            }
          }
        {%- when 'blog' -%}
          ,{
            "@type": "ListItem",
            "position": {{ position }},
            "item": {
              "@id": "{{ request.origin | append: blog.url }}",
              "name": "{{ blog.title | default: 'Blog' | escape }}"
            }
          }
        {%- when 'article' -%}
          ,{
            "@type": "ListItem",
            "position": {{ position }},
            "item": {
              "@id": "{{ request.origin | append: blog.url }}",
              "name": "{{ blog.title | default: 'Blog' | escape }}"
            }
          }
          {%- liquid
            assign position = position | plus: 1
          -%}
          ,{
            "@type": "ListItem",
            "position": {{ position }},
            "item": {
              "@id": "{{ request.origin | append: article.url }}",
              "name": "{{ article.title | default: 'Article' | escape }}"
            }
          }
        {%- when 'page' -%}
          ,{
            "@type": "ListItem",
            "position": {{ position }},
            "item": {
              "@id": "{{ request.origin | append: page.url }}",
              "name": "{{ page.title | default: 'Page' | escape }}"
            }
          }
        {%- else -%}
          {%- unless template == 'index' or template.directory == 'customers' -%}
            ,{
              "@type": "ListItem",
              "position": {{ position }},
              "item": {
                "@id": "{{ request.origin }}{{ request.path }}",
                "name": "{{ page_title | default: 'Page' | escape }}"
              }
            }
          {%- endunless -%}
      {%- endcase -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Breadcrumb Navigation",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "home_text",
      "label": "Home text",
      "default": "Home"
    },
    {
      "type": "checkbox",
      "id": "show_home_icon",
      "label": "Show home icon",
      "default": true
    },
    {
      "type": "select",
      "id": "separator_style",
      "label": "Separator style",
      "options": [
        {
          "value": "chevron",
          "label": "Chevron"
        },
        {
          "value": "slash",
          "label": "Slash"
        },
        {
          "value": "arrow",
          "label": "Arrow"
        }
      ],
      "default": "chevron"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#6366f1"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#4f46e5"
    },
    {
      "type": "color",
      "id": "link_hover_background",
      "label": "Link hover background",
      "default": "#f1f5f9"
    },
    {
      "type": "color",
      "id": "current_color",
      "label": "Current page color",
      "default": "#1e293b"
    },
    {
      "type": "color",
      "id": "current_background",
      "label": "Current page background",
      "default": "#e2e8f0"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator color",
      "default": "#64748b"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "Focus outline color",
      "default": "#6366f1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Item spacing",
      "default": 8
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Breadcrumb Navigation"
    }
  ],
  "tag": null
}
{% endschema %}
