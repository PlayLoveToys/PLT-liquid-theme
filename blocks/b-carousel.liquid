<div
  {{ block.shopify_attributes }}
  class="carousel-wrapper relative col-span-6 md:col-span-3"
>
  {% capture slides %}
    {% for child_block in block.blocks %}
      <div class="col-span-6 md:col-span-3 carousel-item">
        {% case child_block.type %}
          {% when 'b-card-collection' %}
            {% render 'c-card-collection', block: child_block %}
          {% when 'b-card-article' %}
            {% render 'c-card-article', block: child_block %}
          {% when 'b-card-products-grid' %}
            {% render 'c-card-products-grid', block: child_block %}
          {% when 'b-card-collections-grid' %}
            {% render 'c-card-collections-grid', block: child_block %}
        {% endcase %}
      </div>
    {% endfor %}
  {% endcapture %}
  {% render 'ds-carousel',
    slides: slides,
    interval_ms: 3500,
    nav_overlay: true,
    track_class: 'plt-carousel-track',
    prev_label: 'Previous slide',
    next_label: 'Next slide'
  %}
</div>

{% schema %}
{
  "name": "b-Carousel",
  "blocks": [
    {
      "type": "b-card-collection"
    },
    {
      "type": "b-card-article"
    },
    {
      "type": "b-card-products-grid"
    },
    {
      "type": "b-card-collections-grid"
    }
  ],
  "presets": [
    {
      "name": "b-Carousel",
      "category": "b-blocks"
    }
  ]
}
{% endschema %}