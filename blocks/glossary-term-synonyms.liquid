{% doc %}
  Renders synonym chips for a glossary_term metaobject entry.
  @example
  {% content_for 'block', type: 'glossary-term-synonyms', id: 'synonyms' %}
{% enddoc %}

{% liquid
  assign ai_gen_id = block.id | replace: '_', '' | downcase
  assign synonyms = metaobject.synonyms.value
%}

{% if synonyms != blank and synonyms.size > 0 %}
  {% style %}
    .glossary-synonyms-{{ ai_gen_id }} {
      margin: {{ block.settings.margin_top }}px auto {{ block.settings.margin_bottom }}px;
      max-width: {{ block.settings.container_width }}px;
    }

    .glossary-synonyms__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size }}px;
      color: {{ block.settings.heading_color }};
      margin-bottom: 16px;
    }

    .glossary-synonyms__list-{{ ai_gen_id }} {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .glossary-synonyms__chip-{{ ai_gen_id }} {
      display: inline-block;
      padding: 8px 16px;
      border-radius: {{ block.settings.chip_border_radius }}px;
      background-color: {{ block.settings.chip_background }};
      color: {{ block.settings.chip_color }};
      font-size: {{ block.settings.chip_font_size }}px;
      font-weight: 500;
    }
  {% endstyle %}

  <div class="glossary-synonyms-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {% if block.settings.heading != blank %}
      <h2 class="glossary-synonyms__heading-{{ ai_gen_id }} b-title">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    <ul class="glossary-synonyms__list-{{ ai_gen_id }}">
      {% for synonym in synonyms %}
        <li>
          <span class="glossary-synonyms__chip-{{ ai_gen_id }}">{{ synonym }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}

{% schema %}
{
  "name": "Glossary synonyms",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Also known as"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Container width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 24
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "chip_background",
      "label": "Chip background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "chip_color",
      "label": "Chip text color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "chip_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Chip font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "chip_border_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Chip border radius",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom margin",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Glossary synonyms"
    }
  ]
}
{% endschema %}
