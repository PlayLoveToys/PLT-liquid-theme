{%- liquid
  assign span_class = block.settings.col_span
  case span_class
    when 'b-is-col-span-2', 'col-span-2'
      assign span_class = 'col-span-2'
    when 'b-is-col-span-3', 'col-span-3'
      assign span_class = 'col-span-3'
    when 'b-is-col-span-4', 'col-span-4'
      assign span_class = 'col-span-4'
    else
      assign span_class = ''
  endcase
-%}
{% for child in block.blocks -%}
  <div class="min-w-0 {{ span_class }}">
    {% render child %}
  </div>
{%- endfor %}

{% schema %}
{
  "name": "b-cell",
  "settings": [
    {
      "type": "select",
      "id": "col_span",
      "label": "Column Span",
      "default": "",
      "options": [
        { "value": "", "label": "Auto" },
        { "value": "col-span-2", "label": "2" },
        { "value": "col-span-3", "label": "3" },
        { "value": "col-span-4", "label": "4" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "b-carousel"
    },
    {
      "type": "b-card-collection"
    },
    {
      "type": "b-card-article"
    },
    {
      "type": "b-card-products-grid"
    },
    {
      "type": "b-card-collections-grid"
    }
  ],
  "presets": [
    {
      "name": "b-cell",
      "category": "b-Layout"
    }
  ]
}
{% endschema %}