{% liquid
  assign tab_bg = 'bg-info text-info-content'
  case block.settings.tab_color
    when 'b-has-background-primary'
      assign tab_bg = 'bg-primary text-primary-content'
    when 'b-has-background-danger'
      assign tab_bg = 'bg-error text-error-content'
    when 'b-has-background-link'
      assign tab_bg = 'bg-accent text-accent-content'
    when 'b-has-background-dark'
      assign tab_bg = 'bg-neutral text-neutral-content'
    when 'b-has-background-info'
      assign tab_bg = 'bg-info text-info-content'
  endcase
%}

{% style %}
  .vertical-tab-card-{{ block.id }} {
    display: flex;
    flex-direction: row;
    overflow: hidden;
    border-radius: var(--rounded-box, 1rem);
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }

  .vertical-tab-card-{{ block.id }}__tab {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    padding: 1rem 0.5rem;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    text-transform: uppercase;
    font-weight: 700;
  }

  .vertical-tab-card-{{ block.id }}__body {
    flex: 1;
    padding: 1.25rem;
  }
{% endstyle %}

<div class="d-card vertical-tab-card-{{ block.id }}" {{ block.shopify_attributes }}>
  <header class="vertical-tab-card-{{ block.id }}__tab {{ tab_bg }}">
    {{ block.settings.tab_title }}
  </header>

  <div class="vertical-tab-card-{{ block.id }}__body">
    <div class="rte">
      {% if block.settings.content_title != blank %}
        <h3 class="h3 mb-2">{{ block.settings.content_title }}</h3>
      {% endif %}

      {% if block.settings.content_text != blank %}
        <p>{{ block.settings.content_text }}</p>
      {% endif %}

      {% if block.settings.image != blank %}
        <figure class="mt-4 max-w-full">
          {{
            block.settings.image
            | image_url: height: 140, pad_color: 'ffffff'
            | image_tag:
              widths: '50, 80, 100, 120, 140, 160, 180, 200, 250, 300, 350, 400, 450, 500, 550, 600',
              preload: block.settings.priority,
              class: 'h-auto max-w-full'
          }}
        </figure>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vertical Tab Card",

  "settings": [
    {
      "type": "text",
      "id": "tab_title",
      "label": "Título de la pestaña vertical",
      "default": "Título Vertical"
    },
    {
      "type": "select",
      "id": "tab_color",
      "label": "Color de pestaña",
      "default": "b-has-background-info",
      "options": [
        { "value": "b-has-background-info", "label": "Info" },
        { "value": "b-has-background-primary", "label": "Primary" },
        { "value": "b-has-background-danger", "label": "Danger" },
        { "value": "b-has-background-link", "label": "Link" },
        { "value": "b-has-background-dark", "label": "Dark" }
      ]
    },
    {
      "type": "text",
      "id": "content_title",
      "label": "Título del contenido"
    },
    {
      "type": "textarea",
      "id": "content_text",
      "label": "Texto del contenido"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen opcional"
    }
  ],
  "presets": [
    {
      "name": "Vertical Tab Card",
      "category": "Custom"
    }
  ]
}
{% endschema %}