{% if block.settings.button_text != blank and block.settings.button_url != blank %}
  {% liquid
    assign button_classes = 'd-btn theme-label-bold'
    assign alignment_classes = ''

    case block.settings.button_size
      when 'small'
        assign button_classes = button_classes | append: ' d-btn-sm'
      when 'large', 'medium'
        assign button_classes = button_classes | append: ' d-btn-lg'
    endcase

    if block.settings.b_is_outlined
      assign button_classes = button_classes | append: ' d-btn-outline'
    endif

    if block.settings.b_is_ghost
      assign button_classes = button_classes | append: ' d-btn-ghost'
    endif

    if block.settings.b_is_text
      assign button_classes = button_classes | append: ' d-btn-link'
    endif

    if block.settings.b_is_light and block.settings.b_is_outlined == false
      assign button_classes = button_classes | append: ' d-btn-outline'
    endif

    if block.settings.b_is_fullwidth
      assign button_classes = button_classes | append: ' d-btn-block'
    endif

    if block.settings.b_is_rounded
      assign button_classes = button_classes | append: ' d-btn-circle'
    endif

    case block.settings.button_color_style
      when 'primary'
        assign button_classes = button_classes | append: ' d-btn-primary'
      when 'link'
        assign button_classes = button_classes | append: ' d-btn-link'
      when 'info', 'success'
        assign button_classes = button_classes | append: ' d-btn-secondary'
      when 'warning', 'danger'
        assign button_classes = button_classes | append: ' d-btn-neutral'
      else
        assign button_classes = button_classes | append: ' d-btn-primary'
    endcase

    assign alignment_settings = 'button_alignment_mobile,button_alignment_tablet,button_alignment_desktop,button_alignment_widescreen,button_alignment_fullhd' | split: ','

    for setting in alignment_settings
      assign value = block.settings[setting]
      if value != ''
        assign mapped_alignment = value
        case value
          when 'b-has-text-centered-mobile'
            assign mapped_alignment = 'max-md:text-center'
          when 'b-has-text-justified-mobile'
            assign mapped_alignment = 'max-md:text-justify'
          when 'b-has-text-left-mobile'
            assign mapped_alignment = 'max-md:text-left'
          when 'b-has-text-right-mobile'
            assign mapped_alignment = 'max-md:text-right'
          when 'b-has-text-centered-tablet'
            assign mapped_alignment = 'md:text-center'
          when 'b-has-text-justified-tablet'
            assign mapped_alignment = 'md:text-justify'
          when 'b-has-text-left-tablet'
            assign mapped_alignment = 'md:text-left'
          when 'b-has-text-right-tablet'
            assign mapped_alignment = 'md:text-right'
          when 'b-has-text-centered-desktop'
            assign mapped_alignment = 'lg:text-center'
          when 'b-has-text-justified-desktop'
            assign mapped_alignment = 'lg:text-justify'
          when 'b-has-text-left-desktop'
            assign mapped_alignment = 'lg:text-left'
          when 'b-has-text-right-desktop'
            assign mapped_alignment = 'lg:text-right'
          when 'b-has-text-centered-widescreen'
            assign mapped_alignment = 'xl:text-center'
          when 'b-has-text-justified-widescreen'
            assign mapped_alignment = 'xl:text-justify'
          when 'b-has-text-left-widescreen'
            assign mapped_alignment = 'xl:text-left'
          when 'b-has-text-right-widescreen'
            assign mapped_alignment = 'xl:text-right'
          when 'b-has-text-centered-fullhd'
            assign mapped_alignment = '2xl:text-center'
          when 'b-has-text-justified-fullhd'
            assign mapped_alignment = '2xl:text-justify'
          when 'b-has-text-left-fullhd'
            assign mapped_alignment = '2xl:text-left'
          when 'b-has-text-right-fullhd'
            assign mapped_alignment = '2xl:text-right'
        endcase
        assign alignment_classes = alignment_classes | append: ' ' | append: mapped_alignment
      endif
    endfor
  %}

  <div class="{{ alignment_classes | strip }}">
    <a
      href="{{ block.settings.button_url }}"
      class="{{ button_classes }}"
      {% if block.settings.button_new_tab %}
        target="_blank" rel="noopener"
      {% endif %}
      {{ block.shopify_attributes }}
    >
      {{ block.settings.button_text }}
    </a>
  </div>
{% endif %}

{% schema %}
{
  "name": "AA Styled Button",
  "tag": "block",
  "class": "AA Blocks",

  "settings": [
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Click Here" },
    { "type": "url", "id": "button_url", "label": "Button URL" },

    { "type": "header", "content": "Button Settings" },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "normal"
    },

    {
      "type": "header",
      "content": "Responsive Button Alignment"
    },

    {
      "type": "paragraph",
      "content": "Control button alignment for different screen sizes using responsive Tailwind text utilities on the wrapper."
    },

    {
      "type": "select",
      "id": "button_alignment_mobile",
      "label": "Mobile (up to 768px)",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "max-md:text-center", "label": "Centered" },
        { "value": "max-md:text-justify", "label": "Justified" },
        { "value": "max-md:text-left", "label": "Left" },
        { "value": "max-md:text-right", "label": "Right" }
      ],
      "default": ""
    },

    {
      "type": "select",
      "id": "button_alignment_tablet",
      "label": "Tablet (769px+)",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "md:text-center", "label": "Centered" },
        { "value": "md:text-justify", "label": "Justified" },
        { "value": "md:text-left", "label": "Left" },
        { "value": "md:text-right", "label": "Right" }
      ],
      "default": ""
    },

    {
      "type": "select",
      "id": "button_alignment_desktop",
      "label": "Desktop (1024px+)",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "lg:text-center", "label": "Centered" },
        { "value": "lg:text-justify", "label": "Justified" },
        { "value": "lg:text-left", "label": "Left" },
        { "value": "lg:text-right", "label": "Right" }
      ],
      "default": ""
    },

    {
      "type": "select",
      "id": "button_alignment_widescreen",
      "label": "Widescreen (1216px+)",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "xl:text-center", "label": "Centered" },
        { "value": "xl:text-justify", "label": "Justified" },
        { "value": "xl:text-left", "label": "Left" },
        { "value": "xl:text-right", "label": "Right" }
      ],
      "default": ""
    },

    {
      "type": "select",
      "id": "button_alignment_fullhd",
      "label": "Full HD (1408px+)",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "2xl:text-center", "label": "Centered" },
        { "value": "2xl:text-justify", "label": "Justified" },
        { "value": "2xl:text-left", "label": "Left" },
        { "value": "2xl:text-right", "label": "Right" }
      ],
      "default": ""
    },

    { "type": "header", "content": "Button Style Classes" },

    { "type": "checkbox", "id": "b_is_outlined", "label": "Outlined", "default": false },
    { "type": "checkbox", "id": "b_is_text", "label": "Text Style", "default": false },
    { "type": "checkbox", "id": "b_is_ghost", "label": "Ghost", "default": false },
    { "type": "checkbox", "id": "b_is_light", "label": "Light", "default": false },
    { "type": "checkbox", "id": "b_is_responsive", "label": "Responsive", "default": false },
    { "type": "checkbox", "id": "b_is_rounded", "label": "Rounded", "default": false },
    { "type": "checkbox", "id": "b_is_fullwidth", "label": "Full Width", "default": false },
    { "type": "checkbox", "id": "button_new_tab", "label": "Open in new tab", "default": false },

    { "type": "header", "content": "Color Style" },

    {
      "type": "select",
      "id": "button_color_style",
      "label": "Color Style",
      "options": [
        { "value": "link", "label": "Link" },
        { "value": "primary", "label": "Primary" },
        { "value": "info", "label": "Info" },
        { "value": "success", "label": "Success" },
        { "value": "warning", "label": "Warning" },
        { "value": "danger", "label": "Danger" }
      ],
      "default": "primary"
    }
  ],

  "presets": [
    {
      "name": "aa-styled-button",
      "category": "AA Blocks"
    }
  ]
}
{% endschema %}