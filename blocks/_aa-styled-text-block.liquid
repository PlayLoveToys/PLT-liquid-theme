{% if block.settings.text_content != blank %}
  {% liquid
    assign alignment_settings = 'text_alignment_mobile,text_alignment_tablet,text_alignment_desktop,text_alignment_widescreen,text_alignment_fullhd' | split: ','
    assign size_settings = 'text_size_mobile,text_size_tablet,text_size_desktop,text_size_widescreen,text_size_fullhd' | split: ','

    assign alignment_classes = ''
    assign size_classes = ''

    for setting in alignment_settings
      assign value = block.settings[setting]
      if value != ''
        assign mapped_alignment = value
        case value
          when 'b-has-text-centered-mobile'
            assign mapped_alignment = 'max-md:text-center'
          when 'b-has-text-justified-mobile'
            assign mapped_alignment = 'max-md:text-justify'
          when 'b-has-text-left-mobile'
            assign mapped_alignment = 'max-md:text-left'
          when 'b-has-text-right-mobile'
            assign mapped_alignment = 'max-md:text-right'
          when 'b-has-text-centered-tablet'
            assign mapped_alignment = 'md:text-center'
          when 'b-has-text-justified-tablet'
            assign mapped_alignment = 'md:text-justify'
          when 'b-has-text-left-tablet'
            assign mapped_alignment = 'md:text-left'
          when 'b-has-text-right-tablet'
            assign mapped_alignment = 'md:text-right'
          when 'b-has-text-centered-desktop'
            assign mapped_alignment = 'lg:text-center'
          when 'b-has-text-justified-desktop'
            assign mapped_alignment = 'lg:text-justify'
          when 'b-has-text-left-desktop'
            assign mapped_alignment = 'lg:text-left'
          when 'b-has-text-right-desktop'
            assign mapped_alignment = 'lg:text-right'
          when 'b-has-text-centered-widescreen'
            assign mapped_alignment = 'xl:text-center'
          when 'b-has-text-justified-widescreen'
            assign mapped_alignment = 'xl:text-justify'
          when 'b-has-text-left-widescreen'
            assign mapped_alignment = 'xl:text-left'
          when 'b-has-text-right-widescreen'
            assign mapped_alignment = 'xl:text-right'
          when 'b-has-text-centered-fullhd'
            assign mapped_alignment = '2xl:text-center'
          when 'b-has-text-justified-fullhd'
            assign mapped_alignment = '2xl:text-justify'
          when 'b-has-text-left-fullhd'
            assign mapped_alignment = '2xl:text-left'
          when 'b-has-text-right-fullhd'
            assign mapped_alignment = '2xl:text-right'
        endcase
        assign alignment_classes = alignment_classes | append: ' ' | append: mapped_alignment
      endif
    endfor

    for setting in size_settings
      assign value = block.settings[setting]
      if value != ''
        assign mapped_size = value
        case value
          when 'b-is-size-1-mobile'
            assign mapped_size = 'max-md:text-5xl'
          when 'b-is-size-2-mobile'
            assign mapped_size = 'max-md:text-4xl'
          when 'b-is-size-3-mobile'
            assign mapped_size = 'max-md:text-3xl'
          when 'b-is-size-4-mobile'
            assign mapped_size = 'max-md:text-2xl'
          when 'b-is-size-5-mobile'
            assign mapped_size = 'max-md:text-xl'
          when 'b-is-size-6-mobile'
            assign mapped_size = 'max-md:text-base'
          when 'b-is-size-7-mobile'
            assign mapped_size = 'max-md:text-sm'
          when 'b-is-size-1-tablet'
            assign mapped_size = 'md:text-5xl'
          when 'b-is-size-2-tablet'
            assign mapped_size = 'md:text-4xl'
          when 'b-is-size-3-tablet'
            assign mapped_size = 'md:text-3xl'
          when 'b-is-size-4-tablet'
            assign mapped_size = 'md:text-2xl'
          when 'b-is-size-5-tablet'
            assign mapped_size = 'md:text-xl'
          when 'b-is-size-6-tablet'
            assign mapped_size = 'md:text-base'
          when 'b-is-size-7-tablet'
            assign mapped_size = 'md:text-sm'
          when 'b-is-size-1-desktop'
            assign mapped_size = 'lg:text-5xl'
          when 'b-is-size-2-desktop'
            assign mapped_size = 'lg:text-4xl'
          when 'b-is-size-3-desktop'
            assign mapped_size = 'lg:text-3xl'
          when 'b-is-size-4-desktop'
            assign mapped_size = 'lg:text-2xl'
          when 'b-is-size-5-desktop'
            assign mapped_size = 'lg:text-xl'
          when 'b-is-size-6-desktop'
            assign mapped_size = 'lg:text-base'
          when 'b-is-size-7-desktop'
            assign mapped_size = 'lg:text-sm'
          when 'b-is-size-1-widescreen'
            assign mapped_size = 'xl:text-5xl'
          when 'b-is-size-2-widescreen'
            assign mapped_size = 'xl:text-4xl'
          when 'b-is-size-3-widescreen'
            assign mapped_size = 'xl:text-3xl'
          when 'b-is-size-4-widescreen'
            assign mapped_size = 'xl:text-2xl'
          when 'b-is-size-5-widescreen'
            assign mapped_size = 'xl:text-xl'
          when 'b-is-size-6-widescreen'
            assign mapped_size = 'xl:text-base'
          when 'b-is-size-7-widescreen'
            assign mapped_size = 'xl:text-sm'
          when 'b-is-size-1-fullhd'
            assign mapped_size = '2xl:text-5xl'
          when 'b-is-size-2-fullhd'
            assign mapped_size = '2xl:text-4xl'
          when 'b-is-size-3-fullhd'
            assign mapped_size = '2xl:text-3xl'
          when 'b-is-size-4-fullhd'
            assign mapped_size = '2xl:text-2xl'
          when 'b-is-size-5-fullhd'
            assign mapped_size = '2xl:text-xl'
          when 'b-is-size-6-fullhd'
            assign mapped_size = '2xl:text-base'
          when 'b-is-size-7-fullhd'
            assign mapped_size = '2xl:text-sm'
        endcase
        assign size_classes = size_classes | append: ' ' | append: mapped_size
      endif
    endfor
  %}

  <{{ block.settings.text_htag | default: 'p' }}
    class="aa-styled-text aa-styled-text-{{ block.id }}{{ alignment_classes }}{{ size_classes }}"
    {{ block.shopify_attributes }}
  >
    {{ block.settings.text_content }}
  </{{ block.settings.text_htag | default: 'p' }}>
{% endif %}

{% style %}
  {{ block.settings.text_font | font_face }}

  {% liquid
    assign text_mode = block.settings.text_color_mode | default: 'solid'
    assign text_is_gradient = false

    if text_mode == 'gradient'
      assign text_is_gradient = true
    endif

    assign text_color_gradient = block.settings.text_color_gradient | default: 'linear-gradient(90deg, #ff6b6b, #4ecdc4)'
    assign text_color_solid = block.settings.text_color_solid | default: '#111111'

    assign text_font_family = block.settings.text_font.family | default: 'Inter'
    assign text_font_fallback = block.settings.text_font.fallback_families | default: 'sans-serif'
    assign text_font_weight = block.settings.text_font.weight | default: '400'
    assign text_font_style = block.settings.text_font.style | default: 'normal'
  %}

  .aa-styled-text-{{ block.id }} {
    font-family: {{ text_font_family }}, {{ text_font_fallback }};
    font-weight: {{ text_font_weight }};
    font-style: {{ text_font_style }};
    margin: 0;
    {% if text_is_gradient %}
      background-image: {{ text_color_gradient }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      color: transparent;
    {% else %}
      background-image: none;
      -webkit-background-clip: border-box;
      background-clip: border-box;
      -webkit-text-fill-color: initial;
      color: {{ text_color_solid }};
    {% endif %}
  }
{% endstyle %}

