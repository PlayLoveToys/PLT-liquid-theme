<style>
  .a-matrix .d-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
  }

  .a-matrix .d-card .d-card-actions,
  .a-matrix .d-card footer {
    margin-top: auto;
  }
</style>

<section class="a-matrix py-8">
  <div class="page-width">
    <div class="grid grid-cols-12 gap-4">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "a-matrix",
  "settings": [],
  "blocks": [
    {
      "type": "b-carousel"
    },
    {
      "type": "b-card-collection"
    },
    {
      "type": "b-card-article"
    },
    {
      "type": "b-card-products-grid"
    },
    {
      "type": "b-card-collections-grid"
    }
  ],

  "presets": [
    {
      "name": "a-matrix",
      "category": "a-Layout"
    }
  ]
}
{% endschema %}