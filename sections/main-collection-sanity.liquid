{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}

{% capture sanity_locale %}{% render '_filter-locale' %}{% endcapture %}
{% assign sanity_locale = sanity_locale | strip %}

<!-- Hero -->
{% assign header_content = collection.metafields['app--6007307--sanity-fields'].header.value %}
{% if header_content %}
  <section class="py-6">
    <div class="page-width w-full max-w-screen-2xl mx-auto">
      {% render '_collection-hero-collapsable-content',
        header_content: header_content,
        hero_image: section.settings.hero_image
      %}
    </div>
  </section>
{% endif %}

<!-- Collection Products Grid -->
<section class="py-6">
  {%- liquid
    assign collection_sort_by = collection.sort_by | default: collection.default_sort_by
    assign collection_sort_label = 'products.facets.sort_by_label' | t
  -%}
  <div
    id="product-grid-container"
    class="facets-vertical page-width w-full max-w-screen-2xl mx-auto"
    data-plt-section-nav
    data-plt-section-id="{{ section.id }}"
    data-plt-morph-target="#product-grid-container"
  >
    {%- paginate collection.products by 20 -%}
      <div class="facets facets-vertical-sort c-small-screen-hide screen-hide" id="FacetSortForm">
        {% render 'plt-sort-select',
          options: collection.sort_options,
          current: collection_sort_by,
          filters: collection.filters,
          action: collection.url,
          label: collection_sort_label,
          script_url: 'none'
        %}
      </div>

      <aside
        aria-labelledby="verticalTitle"
        class="facets-wrapper"
        id="main-collection-filters"
        data-id="{{ section.id }}"
      >
        {% render 'facets', results: collection, paginate: paginate %}
      </aside>

      <div class="product-grid-container w-full" id="ProductGridContainer">
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width text-center" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient" style="display: none;"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary theme-headline-sm">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div class="collection page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient" style="display: none;"></div>
            <ul
              class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid--2-col-tablet-down grid--4-col-desktop"
              role="list"
            >
              {%- assign skip_card_product_styles = false -%}
              {%- for product in collection.products -%}
                {%- if product.available -%}
                  {%- assign lazy_load = false -%}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}
                  <li class="grid__item">
                    {% render 'card-product',
                      card_product: product,
                      show_vendor: true,
                      show_type: true,
                      show_free_shipping_badge: true,
                      show_savings_percentage: true,
                      media_aspect_ratio: 'square',
                      pad_color: 'ffffff',
                      lazy_load: lazy_load,
                      skip_styles: skip_card_product_styles
                    %}
                    {%- assign skip_card_product_styles = true -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '' %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endpaginate -%}
  </div>
</section>
<!-- END Collection Products Grid -->

<!-- Brand Editorial -->

{% assign brand_editorial_content = collection.metafields['app--6007307--sanity-fields'].brandEditorial.value %}
{% if brand_editorial_content %}
  {% liquid
    capture localized_brand_title
      render '_sanity-value', items: brand_editorial_content.title, key_prefix: 'bet', locale: sanity_locale
    endcapture
    assign localized_brand_title = localized_brand_title | strip
    assign brand_logo = section.settings.logo | default: settings.logo
  %}
  <section class="py-8 page-width">
    <div class="grid grid-cols-1 items-center gap-6 md:grid-cols-12">
      {% if brand_logo %}
        <div class="md:col-span-3">
          <figure class="m-0 max-w-xs">
            {{
              brand_logo
              | image_url: width: 300
              | image_tag:
                widths: '50, 100, 150, 200, 250, 300, 350, 400, 450, 500, 550, 600',
                loading: 'lazy',
                class: 'h-auto w-full'
            }}
          </figure>
        </div>
      {% endif %}
      <div class="{% if brand_logo %}md:col-span-9{% else %}md:col-span-12{% endif %}">
        <div class="logo-motto-text-{{ section.id }}">
          {% if localized_brand_title != blank %}
            <h2 class="theme-headline-sm capitalize text-primary text-2xl md:text-5xl">
              {{ localized_brand_title }}
            </h2>
          {% endif %}
          <div class="brand-editorial-body-{{ section.id }} theme-body prose max-w-none">
            {% render '_sanity-portable-text',
              items: brand_editorial_content.body,
              key_prefix: 'be',
              locale: sanity_locale
            %}
          </div>
        </div>
      </div>
    </div>
  </section>
{% endif %}

<!-- After Page Content -->
{% assign after_page_content = collection.metafields['app--6007307--sanity-fields'].afterPageContent.value.body %}

{% if after_page_content != blank %}
  <section class="py-8">
    <div class="page-width w-full max-w-screen-2xl mx-auto">
      <div class="theme-body prose max-w-none">
        {% render '_sanity-portable-text', items: after_page_content, key_prefix: 'body', locale: sanity_locale %}
      </div>
    </div>
  </section>
{% endif %}

<!-- SEO FAQs -->

{% assign seo_faqs = collection.metafields['app--6007307--sanity-fields'].faqs.value %}
{% if seo_faqs != blank %}
  <section class="py-8">
    <div class="page-width w-full max-w-screen-2xl mx-auto">
      {% render '_collection-seo-faqs', faqs: seo_faqs, locale: sanity_locale %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .collection-products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(500px, 1fr));
  }
{% endstylesheet %}

{% style %}
  @media (min-width: 769px) {
    .logo-motto-text-{{ section.id }} {
      margin-left: 2rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.main-collection-sanity.name",
  "settings": [
    {
      "type": "header",
      "content": "Collection Content"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },

    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "header",
      "content": "Related Products"
    }
  ]
}
{% endschema %}
