<div
  class="page-width mx-auto max-w-3xl py-3 px-3"
  data-cart-fragment
>
  <div class="mb-5 mx-2 flex items-center justify-between">
    <h1 class="m-0 h1">
      {{ 'sections.cart.title' | t }}
    </h1>

    <a
      href="{{ routes.all_products_collection_url }}"
      class="d-btn d-btn-outline d-btn-primary d-btn-sm"
    >
      {{ 'general.continue_shopping' | t }}
    </a>
  </div>

  {% if cart == empty %}
    <div class="py-12 text-center">
      <p class="mb-4 text-lg">
        {{ 'sections.cart.empty' | t }}
      </p>
      <a href="{{ routes.all_products_collection_url }}" class="d-btn d-btn-primary">
        {{ 'general.continue_shopping' | t }}
      </a>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" id="cart">
      {% for item in cart.items %}
        {% render 'cart-item-b', item: item, line_number: forloop.index %}
      {% endfor %}
    </form>
  {% endif %}
</div>

<script src="{{ 'cart-fragment.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}