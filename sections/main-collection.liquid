{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}

{%- paginate collection.products by 20 -%}
  {%- liquid
    assign collection_sort_by = collection.sort_by | default: collection.default_sort_by
    assign collection_sort_label = 'products.facets.sort_by_label' | t
  -%}
  {% comment %}
    JS-A/B: Section Rendering root. Desktop sort in #FacetSortForm; drawer
    facets use plt-filter-bar + plt-sort-select (Alpine only for drawer chrome).
  {% endcomment %}
  <div
    id="product-grid-container"
    class="facets-vertical page-width"
    data-plt-section-nav
    data-plt-section-id="{{ section.id }}"
    data-plt-morph-target="#product-grid-container"
  >
    <div class="facets facets-vertical-sort page-width small-hide" id="FacetSortForm">
      {% render 'plt-sort-select',
        options: collection.sort_options,
        current: collection_sort_by,
        filters: collection.filters,
        action: collection.url,
        label: collection_sort_label,
        script_url: 'none'
      %}
    </div>

    <aside
      aria-labelledby="verticalTitle"
      class="facets-wrapper"
      id="main-collection-filters"
      data-id="{{ section.id }}"
    >
      {% render 'facets', results: collection, paginate: paginate %}
    </aside>

    <div class="product-grid-container" id="ProductGridContainer">
      {%- if collection.products.size == 0 -%}
        <div
          class="collection collection--empty"
          id="product-grid"
          data-id="{{ section.id }}"
        >
          <div class="loading-overlay gradient" style="display: none;"></div>
          <div class="title-wrapper center">
            <h2 class="title title--primary theme-headline-sm">
              {{ 'sections.collection_template.empty' | t -}}
              <br>
              {{
                'sections.collection_template.use_fewer_filters_html'
                | t: link: collection.url, class: 'underlined-link link'
              }}
            </h2>
          </div>
        </div>
      {%- else -%}
        <div class="collection" id="product-grid" data-id="{{ section.id }}">
          <div class="loading-overlay gradient" style="display: none;"></div>
          <ul
            class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid--2-col-tablet-down grid--4-col-desktop grid--5-col-widescreen"
            role="list"
          >
            {%- assign skip_card_product_styles = false -%}
            {%- for product in collection.products -%}
              {%- if product.available -%}
                {%- assign lazy_load = false -%}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}
                <li class="grid__item">
                  {%- comment -%}
                    Colección: flags de paridad con legacy sanity solo aquí. Precios vía snippet
                    price.liquid (money vs money_with_currency según settings.currency_code_enabled).
                  {%- endcomment -%}
                  {% render 'card-product',
                    card_product: product,
                    show_vendor: true,
                    show_type: true,
                    show_free_shipping_badge: true,
                    show_savings_percentage: true,
                    media_aspect_ratio: 'square',
                    pad_color: 'ffffff',
                    lazy_load: lazy_load,
                    skip_styles: skip_card_product_styles
                  %}
                  {%- assign skip_card_product_styles = true -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate, anchor: '' %}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection Product Grid",
  "class": "section",
  "presets": [
    {
      "category": "Collections",
      "name": "Collection Product Grid"
    }
  ]
}
{% endschema %}