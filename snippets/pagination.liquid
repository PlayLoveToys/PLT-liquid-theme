{% comment %}
  Renders numbered pagination via the vendored plt-pagination adapter (compact).

  Usage:
  {% paginate results by 2 %}
    {% render 'pagination', paginate: paginate, anchor: '#yourID' %}
  {% endpaginate %}

  Accepts:
  - paginate: {Object}
  - anchor: {String} (optional) URL fragment appended to every link (e.g. comments).
{% endcomment %}

{%- if paginate.parts.size > 0 -%}
  {%- liquid
    assign pagination_aria_label = 'general.pagination.label' | t
    assign pagination_previous_label = 'general.pagination.previous' | t
    assign pagination_next_label = 'general.pagination.next' | t
    assign pagination_anchor = anchor | default: ''
    assign pagination_compact = true
  -%}
  <div class="flex justify-center my-8">
    {% render 'plt-pagination',
      paginate: paginate,
      compact: pagination_compact,
      anchor: pagination_anchor,
      aria_label: pagination_aria_label,
      previous_label: pagination_previous_label,
      next_label: pagination_next_label
    %}
  </div>
{%- endif -%}
