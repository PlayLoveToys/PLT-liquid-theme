{% liquid
  assign section_id = section.id
  assign image = collection.featured_image
  assign content = header_content
  assign subtitle_htag = subtitle_htag | default: 'p'
  assign icon_fold_svg = 'm356-160-56-56 180-180 180 180-56 56-124-124-124 124Zm124-404L300-744l56-56 124 124 124-124 56 56-180 180Z'
  assign icon_unfold_svg = 'M480-120 300-300l58-58 122 122 122-122 58 58-180 180ZM358-598l-58-58 180-180 180 180-58 58-122-122-122 122Z'

  if image
    assign has_image = true
  else
    assign has_image = false
  endif

  capture sanity_locale
    render '_filter-locale'
  endcapture
  assign sanity_locale = sanity_locale | strip

  capture localized_h1
    render '_sanity-value', items: content.h1, key_prefix: 'h1', locale: sanity_locale
  endcapture
  assign localized_h1 = localized_h1 | strip

  capture localized_subtitle
    render '_sanity-value', items: content.subtitle, key_prefix: 'sub', locale: sanity_locale
  endcapture
  assign localized_subtitle = localized_subtitle | strip

  capture localized_intro
    render '_sanity-value', items: content.intro, key_prefix: 'intro', locale: sanity_locale
  endcapture
  assign localized_intro = localized_intro | strip

  if localized_intro != blank
    assign has_content = true
  else
    assign has_content = false
  endif
%}

<section class="py-8">
  <div class="page-width">
    <div class="d-card p-6">
      <div class="grid grid-cols-1 items-center gap-6 md:grid-cols-12">
        {% if has_image %}
          <div class="content-center md:col-span-4">
            <figure class="w-full">
              {% assign alt_text = collection.title | append: ' - ' | append: 'hero image' %}
              {{
                image
                | image_url: width: 1200
                | image_tag:
                  widths: '300, 350, 400, 450, 500, 550, 600, 650, 700, 750, 800, 850, 900, 950, 1000, 1050, 1100, 1150, 1200',
                  preload: true,
                  loading: 'eager',
                  alt: alt_text,
                  class: 'h-auto w-full'
              }}
            </figure>
          </div>
        {% endif %}
        <div class="flex flex-col justify-evenly gap-4 px-0 md:col-span-8 md:px-6">
          <div class="md:mx-4">
            <h1 class="h1 max-md:text-xl md:text-4xl">
              {{ localized_h1 }}
            </h1>

            {% if localized_subtitle != blank %}
              <h2 class="mt-6 text-lg md:text-2xl">
                {{ localized_subtitle }}
              </h2>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
    {% if has_content %}
      {% capture hero_summary %}
        <span class="d-btn d-btn-outline d-btn-link">
          {% render '_plt-collapse-icons', fold_path: icon_fold_svg, unfold_path: icon_unfold_svg, icon_class: 'inline-flex text-primary' %}
          <span>{{ 'sections.collections.learn_more' | t }}</span>
        </span>
      {% endcapture %}
      {% capture hero_body %}
        <div class="rte my-6">
          {{ localized_intro }}
        </div>
      {% endcapture %}
      {% assign hero_panel_id = 'content-' | append: section_id %}
      {% render '_plt-details-disclosure',
        panel_id: hero_panel_id,
        summary_markup: hero_summary,
        content_markup: hero_body,
        summary_class: 'plt-details-disclosure__summary mt-4'
      %}
    {% endif %}
  </div>
</section>