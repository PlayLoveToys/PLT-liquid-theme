{% liquid
  assign image_class = ''
  if block.settings.priority_mobile
    assign image_class = image_class | append: ' image-priority-mobile-' | append: block.id
  endif
  if block.settings.priority_desktop
    assign image_class = image_class | append: ' image-priority-desktop-' | append: block.id
  endif
  assign image_class = image_class | append: ' h-full w-full object-cover'
%}

<div class="min-w-0 rounded-lg bg-base-100 overflow-hidden shadow-sm" {{ block.shopify_attributes }}>
  <a href="{{ collection.url }}" class="block">
    <figure class="m-0 aspect-square overflow-hidden">
      {{
        collection.image
        | image_url: width: 140
        | image_tag:
          widths: '50, 80, 100, 120, 140, 160, 180, 200',
          loading: 'lazy',
          fetchpriority: 'low',
          preload: false,
          class: image_class
      }}
    </figure>
    <p class="theme-meta px-2 py-1 text-left capitalize m-0">
      {{ title }}
    </p>
  </a>
</div>