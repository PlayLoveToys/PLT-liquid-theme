{% comment %}
  Renders facets (filtering and sorting) as a unified drawer.
  JS-C: native <dialog> (no Alpine). Filter/sort body is plt-filter-bar +
  plt-sort-select; morph via plt-section-nav on an ancestor
  (data-plt-section-nav). Accepts:
  - results: {Object} Collection or Search object
{% endcomment %}

{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign sort_label = 'products.facets.sort_by_label' | t
  assign apply_label = 'products.facets.apply' | t
  assign clear_label = 'products.facets.clear_all' | t

  if results.url
    assign results_url = results.url
    assign form_action = results.url
    assign search_terms = ''
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
    assign form_action = routes.search_url
    assign search_terms = results.terms
  endif
-%}

<style>
  .facets-drawer {
    padding: 0;
    border: 0;
    background: transparent;
    width: 100%;
    height: 100%;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
  }

  .facets-drawer::backdrop {
    background-color: rgba(10, 10, 10, 0.45);
  }

  .facets-drawer[open] {
    display: block;
  }

  .facets-drawer__panel {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--facets-drawer-width, 420px);
    max-width: 85vw;
    height: 100%;
    margin: 0;
    transform: none;
    background: rgb(var(--color-background));
    box-shadow: var(--plt-shadow-offset, 2px 2px 0) rgba(var(--color-shadow), 0.15);
  }

  .facets-drawer__footer {
    margin-top: auto;
    border-top: 1px solid rgba(var(--color-foreground), 0.12);
    background: rgb(var(--color-background));
  }
</style>

<div class="facets-wrapper w-full">
  <div class="sticky top-4 z-[1] flex flex-wrap items-center justify-between gap-3 border-b border-base-300 px-4 pb-3">
    <button
      type="button"
      class="d-btn d-btn-primary d-btn-outline theme-label-bold gap-2"
      onclick="document.getElementById('FacetsDrawer').showModal()"
    >
      <span class="inline-flex size-5 shrink-0 [&_svg]:size-full">
        {{ 'icon-filter.svg' | inline_asset_content }}
      </span>
      <span class="text-lg">{{ 'products.facets.filter_and_sort' | t }}</span>
    </button>

    <p class="text-lg theme-meta m-0">
      {% if results.results_count %}
        {{ 'templates.search.results_with_count' | t: terms: results.terms, count: results.results_count }}
      {% else %}
        {{ 'products.facets.product_count_simple' | t: count: results.products_count }}
      {% endif %}
    </p>
  </div>

  <dialog
    id="FacetsDrawer"
    class="facets-drawer"
    onclick="if (event.target === this) this.close()"
  >
    <div class="facets-drawer__panel flex h-full flex-col px-4 py-6">
      <header class="flex items-center justify-between gap-3 border-b border-base-300 py-4">
        <p class="theme-headline-sm text-primary m-0 text-2xl md:text-3xl">
          {{ 'products.facets.filter_and_sort' | t }}
        </p>
        <button
          type="button"
          class="d-btn d-btn-sm d-btn-circle d-btn-ghost"
          aria-label="{{ 'accessibility.close' | t }}"
          onclick="this.closest('dialog').close()"
        >
          <span aria-hidden="true">&times;</span>
        </button>
      </header>

      <section class="flex-1 overflow-y-auto px-0 py-4">
        {% render 'plt-sort-select',
          options: results.sort_options,
          current: sort_by,
          filters: results.filters,
          search_terms: search_terms,
          action: form_action,
          label: sort_label,
          script_url: 'none'
        %}

        <hr class="theme-divider my-4">

        {% render 'plt-filter-bar',
          filters: results.filters,
          action: form_action,
          orientation: 'vertical',
          collapsible: true,
          sort_by: sort_by,
          search_terms: search_terms,
          apply_label: apply_label,
          clear_label: clear_label,
          script_url: 'none'
        %}
      </section>

      <footer class="facets-drawer__footer px-0 py-4">
        <div class="flex flex-wrap items-stretch justify-between gap-3">
          <button
            type="button"
            class="d-btn d-btn-primary d-btn-sm theme-label-bold flex-1"
            onclick="this.closest('dialog').close()"
          >
            {{ apply_label }}
          </button>
          <a
            href="{{ results_url }}"
            class="d-btn d-btn-ghost d-btn-sm theme-label-bold link flex-1 gap-2"
          >
            <span aria-hidden="true">&times;</span>
            {{- clear_label -}}
          </a>
        </div>
      </footer>
    </div>
  </dialog>
</div>