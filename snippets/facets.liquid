{% comment %}
  Renders facets (filtering and sorting) as a unified drawer.
  JS-C: native <dialog> (no Alpine). Filter/sort body is plt-filter-bar +
  plt-sort-select; morph via plt-section-nav on an ancestor
  (data-plt-section-nav). Accepts:
  - results: {Object} Collection or Search object
{% endcomment %}

{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign sort_label = 'products.facets.sort_by_label' | t
  assign apply_label = 'products.facets.apply' | t
  assign clear_label = 'products.facets.clear_all' | t

  if results.url
    assign results_url = results.url
    assign form_action = results.url
    assign search_terms = ''
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
    assign form_action = routes.search_url
    assign search_terms = results.terms
  endif
-%}

<style>
  .facets-drawer {
    padding: 0;
    border: 0;
    background: transparent;
    width: 100%;
    height: 100%;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
  }

  .facets-drawer::backdrop {
    background-color: rgba(10, 10, 10, 0.45);
  }

  .facets-drawer[open] {
    display: block;
  }

  .facets-drawer .b-drawer-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--b-drawer-width, 420px);
    max-width: 85vw;
    height: 100%;
    margin: 0;
    transform: none;
  }
</style>

<div class="b-container facets-wrapper">
  <!-- Trigger Sticky -->
  <div class="b-level b-top-4 b-px-4 b-border-bottom-light">
    <div class="b-level-left">
      <button
        type="button"
        class="b-button b-is-primary b-is-light"
        onclick="document.getElementById('FacetsDrawer').showModal()"
      >
        <span class="b-icon">
          {{ 'icon-filter.svg' | inline_asset_content }}
        </span>
        <span class="b-is-size-5">{{ 'products.facets.filter_and_sort' | t }}</span>
      </button>
    </div>

    <div class="b-level-right">
      <p class="b-is-size-5">
        {% if results.results_count %}
          {{ 'templates.search.results_with_count' | t: terms: results.terms, count: results.results_count }}
        {% else %}
          {{ 'products.facets.product_count_simple' | t: count: results.products_count }}
        {% endif %}
      </p>
    </div>
  </div>

  <!-- Native dialog drawer (Escape + backdrop click close without Alpine) -->
  <dialog
    id="FacetsDrawer"
    class="facets-drawer"
    onclick="if (event.target === this) this.close()"
  >
    <div class="b-drawer-panel b-is-flex b-is-flex-direction-column b-h-full b-px-4 b-py-6">
      <!-- Header -->
      <header class="b-level b-is-mobile b-is-align-items-center b-py-4 b-px-4 b-border-bottom-light">
        <p class="b-title b-is-3 b-is-4-mobile b-my-0 b-has-text-primary ">
          {{ 'products.facets.filter_and_sort' | t }}
        </p>
        <button
          type="button"
          class="b-delete"
          aria-label="{{ 'accessibility.close' | t }}"
          onclick="this.closest('dialog').close()"
        ></button>
      </header>

      <!-- Body: WC controls (own forms — do not wrap in an outer <form>) -->
      <section class="b-px-4 b-py-4 b-is-flex-grow-1">
        {% render 'plt-sort-select',
          options: results.sort_options,
          current: sort_by,
          filters: results.filters,
          search_terms: search_terms,
          action: form_action,
          label: sort_label,
          script_url: 'none'
        %}

        <hr class="b-dropdown-divider">

        {% render 'plt-filter-bar',
          filters: results.filters,
          action: form_action,
          orientation: 'vertical',
          collapsible: true,
          sort_by: sort_by,
          search_terms: search_terms,
          apply_label: apply_label,
          clear_label: clear_label,
          script_url: 'none'
        %}

      </section>

      <!-- Footer -->
      <div class="b-drawer-footer b-is-radiusless">
        <div class="b-level b-is-mobile">
          <button
            type="button"
            class="b-button b-level-item b-is-primary b-is-small"
            onclick="this.closest('dialog').close()"
          >
            {{ apply_label }}
          </button>
          <a
            href="{{ results_url }}"
            class="b-button b-level-item b-is-ghost b-has-text-link"
          >
            <span class="b-delete b-mr-2"></span>
            {{- clear_label -}}
          </a>
        </div>
      </div>
    </div>
  </dialog>
</div>
