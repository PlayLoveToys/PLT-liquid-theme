<article class="d-card h-full bg-info/20 theme-bordered theme-elevated plt-media-card">
  <header class="px-4 py-3 border-b border-base-content/10">
    <h3 class="d-card-title theme-headline-sm capitalize m-0">
      {{ block.settings.article.title }}
    </h3>
  </header>
  {% if block.settings.article.image %}
    <div class="plt-media-card__media aspect-square overflow-hidden">
      <figure class="m-0 h-full w-full">
        {{
          block.settings.article.image
          | image_url: width: 400
          | image_tag:
            widths: '50, 100, 150, 200, 250, 300, 350, 400, 450, 500, 550, 600',
            loading: 'lazy',
            preload: block.settings.priority,
            class: 'h-full w-full object-cover'
        }}
      </figure>
    </div>
  {% endif %}
  {% if block.settings.show_excerpt %}
    <div class="d-card-body plt-media-card__body p-4">
      <div class="theme-body">
        {{
          block.settings.article.excerpt
          | default: block.settings.article.content
          | strip_html
          | truncatewords: block.settings.truncatewords, '...'
        }}
      </div>
    </div>
  {% endif %}
  <footer class="d-card-actions border-t border-base-content/10 p-4">
    <a
      href="{{ block.settings.article.url }}"
      class="d-btn d-btn-outline d-btn-info theme-label-bold"
    >
      {{ 'general.read_more' | t }}
    </a>
  </footer>
</article>