<article class="d-card h-full bg-primary text-primary-content theme-bordered theme-elevated plt-media-card" {{ block.shopify_attributes }}>
  <header class="px-4 py-3 border-b border-primary-content/10">
    <h3 class="d-card-title theme-headline-sm capitalize m-0 text-primary-content">
      {{ block.settings.collection.title }}
    </h3>
  </header>
  {% if block.settings.collection.featured_image %}
    <div class="plt-media-card__media aspect-square overflow-hidden">
      <figure class="m-0 h-full w-full">
        {{
          block.settings.collection.featured_image
          | image_url: width: 800
          | image_tag:
            widths: '50, 100, 150, 200, 250, 300, 350, 400, 450, 500, 550, 600',
            loading: 'lazy',
            preload: block.settings.priority,
            class: 'h-full w-full object-cover'
        }}
      </figure>
    </div>
  {% endif %}
  <div class="d-card-body plt-media-card__body p-4">
    {% if block.settings.show_description %}
      <div class="theme-body text-sm md:text-base text-primary-content/90">
        {{ block.settings.collection.description | strip_html | truncatewords: block.settings.truncatewords, '...' }}
      </div>
    {% endif %}
  </div>
  <footer class="d-card-actions border-t border-primary-content/10 p-4">
    <a
      href="{{ block.settings.cta_url | default: block.settings.collection.url }}"
      class="d-btn d-btn-link d-btn-block theme-label-bold capitalize text-primary-content"
    >
      {{ block.settings.cta_text }}
    </a>
  </footer>
</article>