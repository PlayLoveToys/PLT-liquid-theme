<article
  class="d-card flex h-full flex-col overflow-hidden bg-primary text-primary-content shadow-md plt-media-card plt-collection-carousel-card"
  {{ block.shopify_attributes }}
>
  <header class="shrink-0 px-3 py-2 md:px-4 md:py-3">
    <h3 class="d-card-title theme-headline-sm m-0 capitalize text-primary-content">
      {{ block.settings.collection.title }}
    </h3>
  </header>
  {% if block.settings.collection.featured_image %}
    <div class="plt-media-card__media aspect-square shrink-0 overflow-hidden">
      <figure class="m-0 h-full w-full">
        {{
          block.settings.collection.featured_image
          | image_url: width: 800
          | image_tag:
            widths: '50, 100, 150, 200, 250, 300, 350, 400, 450, 500, 550, 600',
            loading: 'lazy',
            preload: block.settings.priority,
            class: 'h-full w-full object-cover'
        }}
      </figure>
    </div>
  {% endif %}
  {% if block.settings.show_description %}
    <div class="d-card-body flex-grow p-2 pt-2 text-sm leading-snug text-primary-content md:p-4 md:text-base">
      {{ block.settings.collection.description | strip_html | truncatewords: block.settings.truncatewords, '...' }}
    </div>
  {% endif %}
  <footer class="mt-auto shrink-0 p-2 pb-3 md:px-4 md:pb-4">
    <a
      href="{{ block.settings.cta_url | default: block.settings.collection.url }}"
      class="block w-full text-center text-base font-medium capitalize text-primary-content no-underline hover:underline md:text-lg"
    >
      {{ block.settings.cta_text }}
    </a>
  </footer>
</article>