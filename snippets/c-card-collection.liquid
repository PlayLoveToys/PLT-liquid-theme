<article
  class="d-card plt-collection-carousel-card plt-legacy-bulma-link-card overflow-hidden shadow-md border-0"
  {{ block.shopify_attributes }}
>
  <header class="plt-collection-carousel-card__header">
    <h3 class="plt-collection-carousel-card__title m-0 text-base font-semibold capitalize md:text-lg">
      {{ block.settings.collection.title }}
    </h3>
  </header>
  {% if block.settings.collection.featured_image %}
    <div class="plt-media-card__media plt-collection-carousel-card__image">
      <figure class="plt-collection-carousel-card__figure m-0">
        {{
          block.settings.collection.featured_image
          | image_url: width: 800
          | image_tag:
            widths: '50, 100, 150, 200, 250, 300, 350, 400, 450, 500, 550, 600',
            loading: 'lazy',
            preload: block.settings.priority,
            class: 'plt-collection-carousel-card__img'
        }}
      </figure>
    </div>
  {% endif %}
  {% if block.settings.show_description %}
    <div class="plt-collection-carousel-card__body p-2 text-sm leading-snug md:text-base">
      {{ block.settings.collection.description | strip_html | truncatewords: block.settings.truncatewords, '...' }}
    </div>
  {% endif %}
  <footer class="plt-collection-carousel-card__footer">
    <a
      href="{{ block.settings.cta_url | default: block.settings.collection.url }}"
      class="plt-collection-carousel-card__cta block w-full text-center text-base font-medium capitalize no-underline hover:underline md:text-lg"
    >
      {{ block.settings.cta_text }}
    </a>
  </footer>
</article>