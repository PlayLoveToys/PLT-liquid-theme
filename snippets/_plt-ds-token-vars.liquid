{%- comment -%}
  Variables CSS --plt-* del design system (@playlovetoys/platform, tema cheesecake).
  Invocado desde layout/theme.liquid. Tabla de mapeo: docs/fase1-settings-token-map.md
  Parámetros:
    scope — 'color_scheme' | 'global'
    scheme — objeto de esquema (solo color_scheme)
{%- endcomment -%}
{%- if scope == 'color_scheme' and scheme != blank -%}
  {%- liquid
    assign plt_bg = scheme.settings.background
    assign plt_base_200 = plt_bg | color_lighten: 4
    assign plt_base_300 = plt_bg | color_darken: 6
    assign plt_on_primary = scheme.settings.button_label
    assign plt_secondary = scheme.settings.secondary_button_label
    assign plt_accent = scheme.settings.shadow
  -%}
  --plt-color-base-100: {{ plt_bg }};
  --plt-color-base-200: {{ plt_base_200 }};
  --plt-color-base-300: {{ plt_base_300 }};
  --plt-color-base-content: {{ scheme.settings.text }};
  --plt-color-primary: {{ scheme.settings.button }};
  --plt-color-primary-content: {{ plt_on_primary }};
  --plt-color-secondary: {{ plt_secondary }};
  --plt-color-secondary-content: {{ plt_on_primary }};
  --plt-color-accent: {{ plt_accent }};
  --plt-color-accent-content: {{ plt_on_primary }};
  --plt-color-neutral: {{ scheme.settings.text }};
  --plt-color-neutral-content: {{ scheme.settings.background }};
  --plt-border-color: {{ scheme.settings.text }};
  --plt-shadow-color: {{ scheme.settings.text }};
  {%- comment -%} Semánticos: sin setting en color_schemes; cheesecake fijo (PROPUESTA). {%- endcomment -%}
  --plt-color-info: oklch(90% 0.058 230.902);
  --plt-color-info-content: oklch(44% 0.11 240.79);
  --plt-color-success: oklch(90% 0.093 164.15);
  --plt-color-success-content: oklch(37% 0.077 168.94);
  --plt-color-warning: oklch(96% 0.059 95.617);
  --plt-color-warning-content: oklch(55% 0.163 48.998);
  --plt-color-error: oklch(89% 0.058 10.001);
  --plt-color-error-content: oklch(27% 0.105 12.094);
{%- elsif scope == 'global' -%}
  {%- liquid
    assign plt_btn_border = settings.buttons_border_thickness
    if settings.buttons_border_opacity == 0
      assign plt_btn_border = 0
    endif
    assign plt_field_radius = settings.inputs_radius
    assign plt_selector_radius = settings.variant_pills_radius
    assign plt_box_radius = settings.card_corner_radius | divided_by: 10.0
    assign plt_shadow_vis = false
    if settings.buttons_shadow_opacity > 0
      assign plt_shadow_vis = true
    endif
  -%}
  --plt-font-display: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
  --plt-font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  --plt-font-accent: "Space Grotesk", Arial, sans-serif;
  --plt-radius-field: {{ plt_field_radius }}px;
  --plt-radius-selector: {{ plt_selector_radius }}px;
  --plt-radius-box: {{ plt_box_radius }}rem;
  --plt-size-selector: 0.25rem;
  --plt-size-field: 0.25rem;
  --plt-page-width: {{ settings.page_width | divided_by: 10.0 }}rem;
  {%- comment -%}
    DS cheesecake usa 1.5px / 3px / sombra 2px. Dawn permite 1px y sombras blur — ver desvíos en docs.
  {%- endcomment -%}
  --plt-border-width: 1.5px;
  --plt-section-border-width: 3px;
  --plt-shadow-offset: 2px;
  --plt-shadow-hover-offset: 5px;
  --plt-shadow-active-offset: 0px;
  --plt-merchant-buttons-border-px: {{ plt_btn_border }}px;
  --plt-merchant-buttons-radius-px: {{ settings.buttons_radius }}px;
  {%- if plt_shadow_vis -%}
  --plt-merchant-buttons-shadow-y: {{ settings.buttons_shadow_vertical_offset }}px;
  {%- endif -%}
{%- endif -%}