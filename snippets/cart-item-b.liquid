{%- liquid
  assign variant_title = ''
  unless item.product.has_only_default_variant
    assign variant_title = item.variant.title
  endunless
  assign compare = ''
  if item.original_line_price > item.final_line_price
    assign compare = item.original_line_price | money
  endif
-%}
{%- capture line_json -%}
{"id":{{ item.key | json }},"title":{{ item.product.title | json }},"url":{{ item.url | json }},"imageUrl":{% if item.image %}{{ item.image | image_url: width: 160 | json }}{% else %}null{% endif %},"imageAlt":{{ item.image.alt | default: item.product.title | json }},"variantTitle":{% if variant_title != blank %}{{ variant_title | json }}{% else %}null{% endif %},"quantity":{{ item.quantity | json }},"price":{{ item.final_line_price | money | json }},"compareAtPrice":{% if compare != blank %}{{ compare | json }}{% else %}null{% endif %}}
{%- endcapture -%}
{%- capture labels_json -%}
{"remove":"Remove","decrease":{{ 'products.product.quantity.decrease' | t: product: item.product.title | json }},"increase":{{ 'products.product.quantity.increase' | t: product: item.product.title | json }},"quantity":{{ 'products.product.quantity.input_label' | t: product: item.product.title | json }}}
{%- endcapture -%}
<li class="cart-page__line">
  <plt-cart-line
    line="{{ line_json | strip | escape }}"
    labels="{{ labels_json | strip | escape }}"
  ></plt-cart-line>
</li>