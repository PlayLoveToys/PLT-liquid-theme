<div class="d-card mb-5 p-4">
  <article
    class="flex flex-wrap gap-4"
    x-data="
      {
        error: null,
        id: '{{- item.variant_id -}}',
        quantity: {{ item.quantity }},
        async decrease() {
          const res = await $store.cart.change(this.id, this.quantity - 1);
          if (!res.ok) this.error = res.error;
        },
        async increase() {
          const res = await $store.cart.change(this.id, this.quantity + 1);
          if (!res.ok) this.error = res.error;
        },
        async remove() {
          const res = await $store.cart.change(this.id, 0);
          if (!res.ok) this.error = res.error;
        }
      }
    "
  >
    <div class="mx-auto text-center md:mx-0" style="max-width:100px;">
      <figure class="mx-auto w-full" style="max-width:100px;">
        <img
          src="{{ item.image | image_url: width: 100 }}"
          alt="{{ item.image.alt | escape }}"
          style="width:100%; height:auto; object-fit:contain;"
          width="100"
          height="auto"
          ratio="{{ item.image.ratio }}"
        >
      </figure>

      <button
        class="d-btn d-btn-ghost d-btn-sm mt-5"
        type="button"
        @click.prevent="remove()"
        :disabled="$store.cart.isBusy"
        aria-label="Remove item"
      >
        ×
      </button>
    </div>

    <div class="min-w-0 flex-1 pl-0 md:pl-4">
      <a href="{{ item.url }}" class="mb-2 block text-lg font-semibold link">
        {{ item.product.title }}
      </a>

      <p class="mb-2 text-sm text-base-content/70">
        {{ item.product.vendor }}
      </p>

      {% unless item.product.has_only_default_variant %}
        {% for opt in item.options_with_values %}
          <p class="text-sm text-base-content/70">
            <strong>{{ opt.name }}:</strong> {{ opt.value }}
          </p>
        {% endfor %}
      {% endunless %}

      <p class="text-sm text-base-content/70"><strong> Price: </strong>{{ item.final_price | money }}</p>

      <div class="mt-5 block">
        <p class="mb-2 text-sm text-base-content/70">
          <strong>Qty:</strong>
        </p>

        <div class="join inline-flex">
          <button
            class="d-btn d-btn-primary d-btn-sm join-item"
            style="max-width:20px; min-height:35px;"
            type="button"
            @click.prevent="decrease()"
            :disabled="$store.cart.isBusy"
          >
            −
          </button>

          <input
            class="d-input join-item text-center"
            style="max-width:55px; min-height:35px;"
            type="number"
            name="updates[]"
            x-model="quantity"
            min="0"
            id="updates_{{ item.key }}"
            data-index="{{ forloop.index }}"
          >

          <button
            class="d-btn d-btn-primary d-btn-sm join-item"
            style="max-width:20px; min-height:35px;"
            type="button"
            @click.prevent="increase()"
            :disabled="$store.cart.isBusy"
          >
            +
          </button>
        </div>

        <input
          type="hidden"
          name="line_item_key[]"
          value="{{ item.key }}"
        >
        <input type="hidden" name="attributes[gift_message]" value="">
      </div>

      <p
        class="mt-2 text-sm text-error"
        x-show="error"
        x-text="error"
        x-cloak
      ></p>

      <div class="mt-4 flex justify-end">
        <span class="text-sm text-base-content/70">
          Subtotal:
          <strong class="text-lg">
            {{ item.final_line_price | money_with_currency }}
          </strong>
        </span>
      </div>
    </div>
  </article>
</div>