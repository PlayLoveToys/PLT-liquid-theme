{% liquid
  assign card_title = ''
  assign cta_url = ''
  assign cta_text = ''

  if block.settings.collection != blank
    assign card_title = block.settings.collection.title
    assign cta_url = block.settings.collection.url
  endif
  if block.settings.cta_url
    assign cta_url = block.settings.cta_url
  endif
  if block.settings.cta_text != blank
    assign cta_text = block.settings.cta_text
  endif
  if block.settings.products_card_title != blank
    assign card_title = block.settings.products_card_title
  endif
%}

<article class="d-card h-full bg-primary/25 text-base-content theme-bordered theme-elevated plt-media-card">
  <header class="px-4 py-3 border-b border-base-content/10">
    <h3 class="d-card-title theme-headline-sm capitalize m-0 text-base-100">
      {{ card_title }}
    </h3>
  </header>
  <div class="d-card-body plt-media-card__body p-4">
    {% if block.settings.product_list %}
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
        {% for product in block.settings.product_list %}
          <div class="min-w-0 rounded-lg bg-base-100 overflow-hidden shadow-sm">
            <a href="{{ product.url }}" class="block">
              <figure class="m-0 aspect-square overflow-hidden">
                {{
                  product.featured_image
                  | image_url: width: 300
                  | image_tag:
                    widths: '50, 100, 150, 200, 250, 300, 350, 400, 450, 500, 550, 600',
                    loading: 'lazy',
                    preload: block.settings.priority,
                    class: 'h-full w-full object-cover'
                }}
              </figure>
              <p class="theme-label-bold px-2 py-1 text-right text-sm text-primary m-0">
                {{ product.price | money }}
              </p>
            </a>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
  <footer class="d-card-actions border-t border-base-content/10 p-4">
    <a
      href="{{ cta_url }}"
      class="d-btn d-btn-primary theme-label-bold capitalize"
    >
      {{ cta_text }}
    </a>
  </footer>
</article>