{%- doc -%}
  Intended for use in a block similar to the button block.

  Maps merchant `style_class` setting values (Dawn class names, unchanged ids) to
  design-system `d-btn` variants. Does not rename settings.

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{%- liquid
  case block.settings.style_class
    when 'button-secondary'
      assign ds_btn_class = 'd-btn d-btn-outline theme-label-bold'
    when 'link'
      assign ds_btn_class = 'd-btn d-btn-link theme-label-bold'
    else
      assign ds_btn_class = 'd-btn d-btn-primary theme-label-bold'
  endcase
-%}

<a
  {% if link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ link }}"
  {% endif %}
  class="
    size-style
    {{ ds_btn_class }}
    {{ block.settings.style_class }}--{{ block.id }}
  "
  {%- if block.settings.open_in_new_tab -%}
    target="_blank"
    rel="noopener noreferrer"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  {{ block.settings.label }}
</a>
