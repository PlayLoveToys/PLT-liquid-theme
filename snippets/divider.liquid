{%- doc -%}
  Renders a divider line, used to visually separate content.

  Uses DS `theme-divider` + `--plt-*` tokens. Merchant settings (thickness,
  width %, alignment, radius, spacing) map to local CSS variables.

  @param {string} id - A unique ID for the divider, linking it to a block or section.
  @param {object} settings - An object containing style settings for the divider.

  @param {string} [settings.alignment_horizontal] - The horizontal alignment of the divider ('left', 'center', or
  'right'). Defaults to 'center'.
  @param {number} [settings.thickness] - The thickness of the divider line in pixels.
  @param {string} [settings.corner_radius] - The corner radius of the divider, e.g., 'rounded'.
  @param {number} [settings.width_percent] - The width of the divider as a percentage of its container.

  @param {boolean} [full_width] - When `true`, the divider spans the full width of its container.
  @param {boolean} [attributes] - When `true`, render block.shopify_attributes on the divider container.
{%- enddoc -%}

{%- liquid
  assign alignment = settings.alignment_horizontal | default: 'center'
  case alignment
    when 'left'
      assign justify_content = 'flex-start'
    when 'right'
      assign justify_content = 'flex-end'
    else
      assign justify_content = 'center'
  endcase

  assign thickness = settings.thickness | default: 1
  assign width_percent = settings.width_percent | default: 100
  if full_width
    assign width_percent = 100
  endif

  if settings.corner_radius == 'rounded' and full_width != true
    assign radius = 'var(--plt-radius-selector, 0.25rem)'
  else
    assign radius = '0'
  endif
-%}

<div
  class="divider divider-{{ id }} flex w-full items-center spacing-style"
  style="
    --divider-justify-content: {{ justify_content }};
    --divider-border-thickness: {{ thickness }}px;
    --divider-flex-basis: {{ width_percent }}%;
    --divider-border-radius: {{ radius }};
    --divider-border-color: var(--plt-border-color, var(--plt-color-base-content));
    {% render 'spacing-style', settings: settings %}
  "
  {% if attributes %}
  {% endif %}
>
  <hr
    class="theme-divider divider__line m-0"
    aria-hidden="true"
  >
</div>

<style>
  .divider {
    align-self: stretch;
    justify-content: var(--divider-justify-content, center);
    padding-block-start: var(--padding-block-start, 0);
    padding-block-end: var(--padding-block-end, 0);
  }

  .divider > .theme-divider.divider__line {
    flex-basis: var(--divider-flex-basis, 100%);
    width: var(--divider-flex-basis, 100%);
    max-width: 100%;
    height: 0;
    margin-block: 0;
    border: 0;
    border-top-width: var(--divider-border-thickness, var(--plt-border-width, 1.5px));
    border-top-style: solid;
    border-top-color: var(--divider-border-color);
    border-radius: var(--divider-border-radius, 0);
  }
</style>
